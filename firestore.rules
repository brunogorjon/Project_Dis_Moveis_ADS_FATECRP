rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome', 'email', 'telefone', 'criadoEm', 'atualizadoEm'])
        && request.resource.data.keys().hasAll(['nome', 'email', 'telefone', 'criadoEm', 'atualizadoEm'])
        && request.resource.data.nome is string
        && request.resource.data.telefone is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.atualizadoEm is timestamp;
    }
    match /rateios/{id} {
      function autenticado() { return request.auth != null; }
      function valido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['ownerId', 'nome', 'valorTotalCentavos', 'capacidade', 'concluido', 'criadoEm', 'meses', 'participantes', 'pagamentos', 'revisao'])
          && d.keys().hasAll(['ownerId', 'nome', 'valorTotalCentavos', 'capacidade', 'concluido', 'criadoEm', 'meses', 'participantes', 'pagamentos', 'revisao'])
          && d.ownerId is string && d.nome is string
          && d.valorTotalCentavos is int && d.valorTotalCentavos > 0
          && d.capacidade is int && d.capacidade > 0
          && d.concluido is bool && d.criadoEm is timestamp
          && d.meses is list && d.meses.size() > 0
          && d.participantes is list && d.pagamentos is list
          && d.revisao is int && d.revisao > 0;
      }
      allow create: if autenticado() && request.resource.data.ownerId == request.auth.uid && request.resource.data.revisao == 1 && valido();
      allow read, delete: if autenticado() && resource.data.ownerId == request.auth.uid;
      allow update: if autenticado() && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.revisao == resource.data.revisao + 1 && valido();
    }
  }
}
